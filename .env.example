PORT=8080
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com
# Project-local private CLI configuration, ignored by git (never your home directory):
QLOO_HOME=.qloo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Evidence cache (Qloo/FEMA/Wikidata responses, 7-day TTL); omit to disable persistence:
CACHE_DIR=.cache
# Build the demo presets at startup (needs always-on CPU on Cloud Run); 0 disables:
PREWARM=1
